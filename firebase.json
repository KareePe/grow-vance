{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.json",
      "breif/**",
      "designs/**",
      "mockup/**",
      "support.js",
      "assets/img/bg-*.png",
      "assets/img/bg-contact.webp",
      "assets/img/LOGO-640x640.jpg",
      "assets/img/icon-4.png",
      "assets/img/project-team-collaborating-business-analytics.jpg",
      "assets/img/creative-agency-*.jpg",
      "demo-*.html",
      "**/*.log",
      "**/*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(webp|avif|png|jpg|jpeg|svg|ico|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(html|txt|xml)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      }
    ]
  }
}
