{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.json",
      "breif/**",
      "designs/**",
      "mockup/**",
      "support.js",
      "assets/img/bg-*.png",
      "demo-*.html"
    ],
    "headers": [
      {
        "source": "**/*.@(webp|avif|png|jpg|jpeg|svg|ico|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(html|txt|xml)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      }
    ]
  }
}
